{
  "inputs": [
    {
      "type": "promptString",
      "id": "datadoe-key",
      "description": "DataDoe MCP API Key",
      "password": true
    }
  ],
  "servers": {
    "datadoe": {
      "type": "http",
      "url": "https://api.datadoe.com/mcp/v1?",
      "headers": {
        "datadoe-mcp-key": "${input:datadoe-key}"
      }
    }
  }
}
